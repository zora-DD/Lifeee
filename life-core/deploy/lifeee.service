[Unit]
Description=Lifeee API Service
After=network.target mysql.service
Wants=mysql.service

[Service]
Type=simple
User=lifeee
Group=www-data
WorkingDirectory=/opt/lifeee
ExecStart=/opt/lifeee/bin/lifeee
Restart=on-failure
RestartSec=5s
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/lifeee
LockPersonality=true
MemoryDenyWriteExecute=true

[Install]
WantedBy=multi-user.target
