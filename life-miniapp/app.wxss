page {
  background: #f6f8f7;
  color: #26332e;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

button {
  border-radius: 12rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 40rpx 32rpx 56rpx;
}

.tab-page {
  padding-bottom: 190rpx;
}

.page-header {
  margin-bottom: 32rpx;
}

.eyebrow {
  margin-bottom: 8rpx;
  color: #628574;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.page-title {
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.page-subtitle {
  margin-top: 12rpx;
  color: #6f7b76;
  font-size: 27rpx;
  line-height: 1.6;
}

.card {
  background: #ffffff;
  border: 1rpx solid #e2e8e5;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 30rpx rgba(37, 48, 43, 0.055);
}

.login-required {
  margin-top: 150rpx;
  padding: 58rpx 42rpx 48rpx;
  text-align: center;
}

.login-required-icon {
  display: flex;
  width: 92rpx;
  height: 92rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  color: #557565;
  font-size: 40rpx;
  font-weight: 600;
  background: #edf3f0;
  border-radius: 29rpx;
}

.login-required-icon.food {
  color: #8b6642;
  background: #f6eee4;
}

.login-required-icon.place {
  color: #54798b;
  background: #eaf1f4;
}

.login-required-title {
  margin-top: 26rpx;
  color: #303d37;
  font-size: 32rpx;
  font-weight: 700;
}

.login-required-text {
  margin-top: 11rpx;
  color: #747f79;
  font-size: 24rpx;
  line-height: 1.6;
}

.login-required-button {
  width: 280rpx;
  margin: 30rpx auto 0;
  padding: 20rpx 0;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  background: #6f9785;
  border-radius: 22rpx;
  box-shadow: 0 9rpx 22rpx rgba(67, 103, 87, 0.17);
}

.tap-feedback {
  opacity: 0.72;
}

.page-loading {
  display: flex;
  min-height: 540rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #7a857f;
  font-size: 24rpx;
}

.loading-ring {
  width: 42rpx;
  height: 42rpx;
  margin-bottom: 18rpx;
  border: 4rpx solid #dce7e2;
  border-top-color: #6f9785;
  border-radius: 50%;
  animation: page-loading-spin 800ms linear infinite;
}

@keyframes page-loading-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
