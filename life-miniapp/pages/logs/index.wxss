.record-header {
  margin-bottom: 24rpx;
}

.mode-switch {
  display: flex;
  margin-bottom: 24rpx;
  padding: 7rpx;
  background: #e9efec;
  border-radius: 24rpx;
}

.mode-item {
  display: flex;
  height: 72rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  color: #78847e;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 19rpx;
  transition: all 180ms ease;
}

.mode-item.active {
  color: #476d5c;
  background: #ffffff;
  box-shadow: 0 6rpx 20rpx rgba(46, 71, 60, 0.09);
}

.mode-item.bill-active {
  color: #87643f;
}

.mode-icon {
  display: flex;
  width: 38rpx;
  height: 38rpx;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  color: inherit;
  font-size: 20rpx;
  background: rgba(116, 149, 134, 0.11);
  border-radius: 12rpx;
}

.composer-card {
  padding: 30rpx;
  background: linear-gradient(145deg, #ffffff, #f1f6f3);
}

.bill-composer {
  padding: 30rpx;
  background: linear-gradient(145deg, #fffdfa, #f7f2ea);
  border-color: #ece2d4;
}

.bill-kicker {
  color: #9a744b;
}

.bill-voice {
  color: #8b6948;
  background: #f3e8da;
}

.quick-input-wrap {
  display: block;
  box-sizing: border-box;
  margin-top: 24rpx;
  padding: 20rpx;
  background: #ffffff;
  border: 1rpx solid #eadfd2;
  border-radius: 22rpx;
}

.quick-input {
  display: block;
  box-sizing: border-box;
  width: 100%;
  min-width: 0;
  min-height: 96rpx;
  max-height: 180rpx;
  padding: 4rpx 2rpx;
  color: #423c35;
  font-size: 26rpx;
  line-height: 1.55;
}

.quick-submit-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
  padding-top: 14rpx;
  color: #a09588;
  font-size: 20rpx;
  border-top: 1rpx solid #f0e8de;
}

.parse-button {
  display: flex;
  width: 150rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 650;
  background: #9b7954;
  border-radius: 18rpx;
}

.parse-button::after {
  border: 0;
}

.quick-hint {
  margin-top: 16rpx;
  color: #968878;
  font-size: 21rpx;
  line-height: 1.5;
}

.spark {
  margin-right: 8rpx;
  color: #b28a5b;
}

.bill-overview {
  position: relative;
  z-index: 20;
  display: flex;
  align-items: stretch;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 28rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #698b7c, #82a392);
  border: 0;
  box-shadow: 0 14rpx 32rpx rgba(68, 101, 86, 0.16);
}

.overview-main {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  justify-content: center;
}

.overview-label {
  color: rgba(255, 255, 255, 0.78);
  font-size: 22rpx;
}

.overview-month-wrap {
  position: relative;
  z-index: 1201;
  align-self: flex-start;
}

.overview-month-filter {
  display: flex;
  height: 46rpx;
  align-items: center;
  padding: 0 16rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
  font-weight: 600;
  background: rgba(255, 255, 255, 0.12);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  border-radius: 14rpx;
}

.overview-filter-arrow {
  width: 9rpx;
  height: 9rpx;
  margin-left: 12rpx;
  border-right: 2rpx solid rgba(255, 255, 255, 0.82);
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.82);
  transform: translateY(-2rpx) rotate(45deg);
  transition: transform 160ms ease;
}

.overview-month-filter.open .overview-filter-arrow {
  transform: translateY(2rpx) rotate(225deg);
}

.currency {
  margin-right: 5rpx;
  font-size: 28rpx;
  font-weight: 650;
}

.overview-amount {
  margin-top: 7rpx;
  font-size: 46rpx;
  font-weight: 750;
  letter-spacing: -1rpx;
}

.overview-side {
  display: flex;
  width: 132rpx;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding-left: 20rpx;
  text-align: center;
  border-left: 1rpx solid rgba(255, 255, 255, 0.2);
}

.overview-side > view {
  display: flex;
  flex-direction: column;
}

.side-value {
  font-size: 27rpx;
  font-weight: 700;
}

.side-label {
  margin-top: 8rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 19rpx;
}

.bill-toolbar {
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
  margin: 36rpx 4rpx 18rpx;
}

.list-heading-tools {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.creator-filter-wrap,
.month-filter-wrap {
  position: relative;
  z-index: 1201;
}

.creator-filter {
  display: flex;
  box-sizing: border-box;
  min-width: 190rpx;
  height: 64rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 22rpx;
  color: #567565;
  font-size: 23rpx;
  font-weight: 600;
  background: #f9fcfa;
  border: 2rpx solid #b7cec2;
  border-radius: 999rpx;
}

.month-filter {
  min-width: 190rpx;
}

.creator-filter.open {
  color: #47705d;
  background: #f1f7f4;
  border-color: #88ad9b;
  border-bottom-color: #dce9e2;
  border-radius: 22rpx 22rpx 0 0;
}

.creator-filter.month-filter.open {
  border-bottom-color: #88ad9b;
  border-radius: 999rpx;
}

.filter-arrow {
  width: 12rpx;
  height: 12rpx;
  margin-left: 18rpx;
  border-right: 3rpx solid #769486;
  border-bottom: 3rpx solid #769486;
  transform: translateY(-3rpx) rotate(45deg);
  transition: transform 160ms ease;
}

.creator-filter.open .filter-arrow {
  transform: translateY(3rpx) rotate(225deg);
}

.creator-dropdown-mask {
  position: fixed;
  z-index: -1;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: transparent;
}

.creator-dropdown {
  position: absolute;
  top: calc(100% - 2rpx);
  right: 0;
  box-sizing: border-box;
  width: 100%;
  overflow: hidden;
  background: #f9fcfa;
  border: 2rpx solid #88ad9b;
  border-top: 0;
  border-radius: 0 0 22rpx 22rpx;
  box-shadow: 0 16rpx 34rpx rgba(49, 75, 62, 0.14);
}

.month-dropdown {
  top: calc(100% + 8rpx);
  right: 0;
  left: auto;
  box-sizing: border-box;
  width: 420rpx;
  padding: 18rpx;
  border-top: 2rpx solid #88ad9b;
  border-radius: 22rpx;
}

.creator-dropdown.overview-month-dropdown {
  top: calc(100% + 8rpx);
  right: auto;
  left: 0;
  width: 420rpx;
  padding: 18rpx;
  border: 1rpx solid #dbe8e1;
  border-radius: 22rpx;
  box-shadow: 0 16rpx 38rpx rgba(35, 58, 48, 0.2);
}

.month-dropdown-year {
  padding: 2rpx 8rpx 15rpx;
  color: #71837a;
  font-size: 21rpx;
  font-weight: 650;
}

.month-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.month-grid-item {
  display: flex;
  box-sizing: border-box;
  width: calc((100% - 30rpx) / 4);
  height: 62rpx;
  align-items: center;
  justify-content: center;
  color: #64766d;
  font-size: 22rpx;
  font-weight: 600;
  background: #f1f5f3;
  border-radius: 14rpx;
}

.month-grid-item.selected {
  color: #ffffff;
  background: #6f9a85;
}

.creator-dropdown-list {
  max-height: 360rpx;
}

.creator-dropdown-item {
  display: flex;
  min-height: 72rpx;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  padding: 0 20rpx;
  color: #567565;
  font-size: 23rpx;
  font-weight: 550;
}

.creator-dropdown-item + .creator-dropdown-item {
  border-top: 1rpx solid #edf1ef;
}


.bill-day {
  margin-bottom: 22rpx;
}

.bill-day-title {
  margin: 0 5rpx 12rpx;
  color: #68746e;
  font-size: 23rpx;
  font-weight: 650;
}

.bill-list {
  overflow: hidden;
}

.bill-row {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border-bottom: 1rpx solid #edf0ee;
}

.bill-row:last-child {
  border-bottom: 0;
}

.bill-category-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  font-size: 31rpx;
  background: #f4ece1;
  border-radius: 21rpx;
}

.bill-info {
  min-width: 0;
  flex: 1;
  margin-left: 18rpx;
}

.bill-title-line {
  display: flex;
  align-items: center;
}

.bill-title {
  max-width: 230rpx;
  overflow: hidden;
  color: #36423c;
  font-size: 27rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-category {
  margin-left: 10rpx;
  padding: 4rpx 9rpx;
  color: #8b765d;
  font-size: 18rpx;
  background: #f7f1e9;
  border-radius: 9rpx;
}

.bill-meta {
  display: flex;
  max-width: 330rpx;
  gap: 7rpx;
  margin-top: 8rpx;
  overflow: hidden;
  color: #8a948f;
  font-size: 20rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.bill-right {
  margin-left: 12rpx;
  text-align: right;
}

.bill-amount {
  color: #4a5550;
  font-size: 28rpx;
  font-weight: 700;
}

.bill-amount.income {
  color: #5f8c76;
}

.bill-actions {
  display: flex;
  justify-content: flex-end;
  gap: 10rpx;
  margin-top: 9rpx;
}

.bill-action {
  display: flex;
  box-sizing: border-box;
  min-width: 76rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 15rpx;
  font-size: 21rpx;
  font-weight: 600;
  border-radius: 16rpx;
}

.bill-action.edit {
  color: #60786c;
  background: #edf3f0;
}

.bill-action.delete {
  color: #ad6964;
  background: #f8eeec;
}

.bill-empty {
  color: #8b6b48;
  background: #f4ebe0;
}

.composer-card.editing {
  border-color: #bfd3ca;
  box-shadow: 0 10rpx 30rpx rgba(71, 105, 90, 0.09);
}

.composer-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.composer-kicker {
  color: #618171;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.composer-title {
  margin-top: 6rpx;
  color: #303d37;
  font-size: 31rpx;
  font-weight: 700;
}

.voice-button {
  display: flex;
  height: 62rpx;
  align-items: center;
  padding: 0 19rpx;
  color: #567565;
  font-size: 23rpx;
  font-weight: 600;
  background: #eaf2ee;
  border-radius: 20rpx;
}

.voice-button.recording {
  color: #a65353;
  background: #f8e8e6;
}

.voice-button.recognizing {
  color: #6e776f;
  background: #eef1ef;
  opacity: 0.8;
}

.voice-glyph {
  position: relative;
  box-sizing: border-box;
  width: 20rpx;
  height: 29rpx;
  margin-right: 10rpx;
  border: 3rpx solid currentColor;
  border-radius: 12rpx;
}

.voice-glyph::after {
  position: absolute;
  right: -8rpx;
  bottom: -9rpx;
  left: -8rpx;
  height: 16rpx;
  border: 3rpx solid currentColor;
  border-top: 0;
  border-radius: 0 0 14rpx 14rpx;
  content: '';
}

.voice-modal-mask {
  position: fixed;
  z-index: 2000;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  box-sizing: border-box;
  padding: 28rpx 28rpx calc(30rpx + env(safe-area-inset-bottom));
  background: rgba(31, 43, 37, 0.38);
  backdrop-filter: blur(8rpx);
}

.voice-status-mask {
  align-items: center;
  padding: 40rpx;
}

.voice-status-modal {
  box-sizing: border-box;
  width: 100%;
  padding: 54rpx 36rpx 36rpx;
  text-align: center;
  background: #f8fbf9;
  border-radius: 34rpx;
  box-shadow: 0 24rpx 80rpx rgba(32, 53, 43, 0.22);
}

.voice-status-orb {
  position: relative;
  display: flex;
  width: 116rpx;
  height: 116rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  color: #ffffff;
  border-radius: 50%;
}

.voice-status-orb .voice-glyph {
  z-index: 2;
  width: 26rpx;
  height: 38rpx;
  margin: 0;
}

.recording-orb {
  background: #c96e68;
  box-shadow: 0 0 0 16rpx rgba(201, 110, 104, 0.1);
}

.voice-wave {
  position: absolute;
  top: -12rpx;
  right: -12rpx;
  bottom: -12rpx;
  left: -12rpx;
  border: 2rpx solid rgba(201, 110, 104, 0.35);
  border-radius: 50%;
  animation: voice-wave 1.8s ease-out infinite;
}

.voice-wave-two {
  animation-delay: 0.9s;
}

.processing-orb {
  background: #e7f0eb;
}

.voice-processing-ring {
  box-sizing: border-box;
  width: 58rpx;
  height: 58rpx;
  border: 6rpx solid rgba(103, 146, 126, 0.18);
  border-top-color: #6f9684;
  border-radius: 50%;
  animation: voice-spin 0.9s linear infinite;
}

.voice-status-kicker {
  margin-top: 34rpx;
  color: #789487;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.voice-status-title {
  margin-top: 10rpx;
  color: #304039;
  font-size: 34rpx;
  font-weight: 700;
}

.voice-recording-time {
  margin-top: 16rpx;
  color: #b05f5a;
  font-size: 44rpx;
  font-weight: 700;
}

.voice-status-note {
  margin-top: 14rpx;
  color: #7f8b85;
  font-size: 23rpx;
  line-height: 1.6;
}

.voice-recording-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 38rpx;
}

.voice-discard-button,
.voice-finish-button {
  display: flex;
  height: 82rpx;
  flex: 1;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 650;
  border-radius: 23rpx;
}

.voice-discard-button {
  color: #747f79;
  background: #e9efec;
}

.voice-finish-button {
  color: #ffffff;
  background: #6f9684;
}

@keyframes voice-wave {
  from { transform: scale(0.86); opacity: 0.8; }
  to { transform: scale(1.3); opacity: 0; }
}

@keyframes voice-spin {
  to { transform: rotate(360deg); }
}

.voice-modal {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  flex-direction: column;
  overflow: hidden;
  padding: 36rpx 30rpx 30rpx;
  background: #f8fbf9;
  border-radius: 34rpx;
  box-shadow: 0 24rpx 80rpx rgba(32, 53, 43, 0.22);
}

.voice-modal.bill-mode {
  height: 82vh;
  max-height: 1200rpx;
}

.voice-modal-scroll {
  min-height: 0;
}

.bill-mode .voice-modal-scroll {
  height: 0;
  flex: 1;
  margin-top: 20rpx;
  padding-bottom: 12rpx;
}

.activity-draft-scroll {
  max-height: 56vh;
}

.draft-heading {
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.draft-heading .voice-modal-kicker,
.draft-heading .voice-modal-title {
  margin-top: 0;
}

.draft-heading .voice-modal-title {
  margin-top: 5rpx;
}

.voice-modal-icon {
  display: flex;
  width: 68rpx;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: #789b8b;
  border-radius: 22rpx;
}

.bill-draft-icon {
  color: #ffffff;
  background: #9b7954;
}

.voice-modal-icon .voice-glyph {
  margin: 0;
}

.voice-modal-kicker {
  margin-top: 22rpx;
  color: #6d8c7d;
  font-size: 21rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.voice-modal-title {
  margin-top: 7rpx;
  color: #304039;
  font-size: 32rpx;
  font-weight: 700;
}

.voice-result-card {
  margin-top: 24rpx;
  padding: 24rpx;
  background: #ffffff;
  border: 1rpx solid #dfe9e4;
  border-radius: 23rpx;
}

.voice-result-label {
  color: #809087;
  font-size: 21rpx;
}

.voice-result-content {
  margin-top: 10rpx;
  color: #34433c;
  font-size: 27rpx;
  line-height: 1.65;
}

.voice-result-meta {
  margin-top: 15rpx;
  color: #6a897a;
  font-size: 22rpx;
}

.voice-raw {
  margin-top: 16rpx;
  padding: 0 4rpx;
  color: #7e8984;
  font-size: 22rpx;
  line-height: 1.6;
}

.voice-raw .voice-result-label {
  margin-bottom: 6rpx;
}

.voice-modal-actions {
  display: flex;
  flex-shrink: 0;
  gap: 14rpx;
  margin-top: 28rpx;
  padding-top: 4rpx;
}

.draft-count {
  color: #7d8882;
  font-size: 22rpx;
}

.bill-draft-card {
  margin-top: 18rpx;
  padding: 22rpx;
  background: #ffffff;
  border: 1rpx solid #e7e2da;
  border-radius: 23rpx;
}

.bill-draft-number {
  color: #8c714f;
  font-size: 21rpx;
  font-weight: 700;
}

.draft-type-row {
  display: flex;
  gap: 10rpx;
  margin-top: 14rpx;
}

.draft-type {
  padding: 9rpx 22rpx;
  color: #8b8175;
  font-size: 21rpx;
  background: #f3f0eb;
  border-radius: 14rpx;
}

.draft-type.active {
  color: #8b5f3d;
  background: #f5e7d7;
}

.draft-type.income-type.active {
  color: #507b66;
  background: #e4f0e9;
}

.draft-field {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  margin-top: 12rpx;
  padding: 0 18rpx;
  background: #f8faf9;
  border-radius: 16rpx;
}

.draft-field input {
  min-width: 0;
  flex: 1;
  color: #3f4944;
  font-size: 24rpx;
  text-align: right;
}

.draft-label {
  margin-right: 14rpx;
  color: #89938e;
  font-size: 21rpx;
}

.amount-input {
  display: flex;
  min-width: 0;
  flex: 1;
  align-items: center;
  justify-content: flex-end;
  color: #8b6948;
  font-size: 25rpx;
  font-weight: 650;
}

.amount-input input {
  max-width: 190rpx;
  margin-left: 5rpx;
  color: #584737;
  font-size: 29rpx;
  font-weight: 700;
}

.draft-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10rpx;
  margin-top: 12rpx;
}

.draft-grid picker:first-child {
  grid-column: 1 / 3;
}

.draft-picker {
  display: flex;
  height: 64rpx;
  align-items: center;
  justify-content: space-between;
  padding: 0 16rpx;
  color: #56635d;
  font-size: 21rpx;
  background: #f8faf9;
  border-radius: 16rpx;
}

.bill-confirm {
  background: #8e7150;
}

.bill-confirm::after {
  border: 0;
}

.voice-cancel,
.voice-confirm {
  display: flex;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  font-size: 25rpx;
  font-weight: 650;
  border-radius: 22rpx;
}

.voice-cancel {
  width: 180rpx;
  color: #6b7972;
  background: #e9efec;
}

.voice-confirm {
  flex: 1;
  color: #ffffff;
  background: #6f9684;
}

.log-input {
  box-sizing: border-box;
  width: 100%;
  min-height: 176rpx;
  max-height: 360rpx;
  margin-top: 26rpx;
  padding: 24rpx;
  color: #33413a;
  font-size: 27rpx;
  line-height: 1.7;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid #dfe8e3;
  border-radius: 22rpx;
}

.meta-row {
  display: flex;
  gap: 14rpx;
  margin-top: 18rpx;
}

.meta-picker {
  flex: 1;
}

.meta-control {
  display: flex;
  height: 68rpx;
  align-items: center;
  justify-content: center;
  color: #52625b;
  font-size: 23rpx;
  background: #ffffff;
  border: 1rpx solid #e0e7e3;
  border-radius: 19rpx;
}

.meta-icon {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  margin-right: 10rpx;
  color: #60806f;
  font-size: 18rpx;
  font-weight: 700;
  background: #edf4f0;
  border-radius: 10rpx;
}

.duration-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding: 18rpx 20rpx;
  background: rgba(255, 255, 255, 0.72);
  border-radius: 18rpx;
}

.duration-label {
  color: #66736d;
  font-size: 24rpx;
}

.required-mark {
  color: #c36c67;
}

.duration-input-wrap {
  display: flex;
  align-items: center;
  color: #7b8680;
  font-size: 23rpx;
}

.duration-input {
  width: 120rpx;
  margin-right: 8rpx;
  color: #34423c;
  font-size: 25rpx;
  text-align: right;
}

.composer-actions {
  display: flex;
  gap: 14rpx;
  margin-top: 22rpx;
}

.cancel-button,
.save-button {
  display: flex;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  border-radius: 21rpx;
}

.cancel-button {
  width: 150rpx;
  color: #68746e;
  background: #edf1ef;
}

.save-button {
  flex: 1;
  margin: 0;
  color: #ffffff;
  background: #6f9785;
  box-shadow: 0 8rpx 20rpx rgba(67, 103, 87, 0.16);
}

.save-button::after {
  border: 0;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 36rpx 4rpx 20rpx;
}

.list-heading .month-filter {
  min-width: 190rpx;
}

.list-title {
  color: #34423c;
  font-size: 29rpx;
  font-weight: 700;
}

.list-note {
  margin-top: 5rpx;
  color: #8a948f;
  font-size: 21rpx;
}

.record-count {
  padding: 8rpx 14rpx;
  color: #60796d;
  font-size: 22rpx;
  background: #edf3f0;
  border-radius: 15rpx;
}

.day-group {
  margin-bottom: 26rpx;
}

.day-heading {
  display: flex;
  align-items: center;
  margin: 0 4rpx 14rpx;
  color: #56655e;
  font-size: 24rpx;
  font-weight: 650;
}

.day-dot {
  width: 13rpx;
  height: 13rpx;
  margin-right: 11rpx;
  background: #729986;
  border: 5rpx solid #e7f0eb;
  border-radius: 50%;
}

.timeline {
  position: relative;
  padding-left: 22rpx;
}

.timeline::before {
  position: absolute;
  top: -14rpx;
  bottom: 10rpx;
  left: 10rpx;
  width: 2rpx;
  background: #dfe8e3;
  content: '';
}

.log-card {
  position: relative;
  margin-bottom: 16rpx;
  padding: 25rpx 26rpx 22rpx;
}

.detail-action {
  color: #557565;
}

.log-meta {
  display: flex;
  align-items: center;
}

.log-time {
  color: #557565;
  font-size: 25rpx;
  font-weight: 700;
}

.log-duration {
  margin-left: 12rpx;
  padding: 5rpx 11rpx;
  color: #8d6945;
  font-size: 21rpx;
  background: #f7efe5;
  border-radius: 11rpx;
}

.log-content {
  margin-top: 13rpx;
  color: #35423c;
  font-size: 27rpx;
  line-height: 1.72;
  white-space: pre-wrap;
}

.log-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid #edf0ee;
}

.creator-mark {
  display: flex;
  box-sizing: border-box;
  max-width: 190rpx;
  min-width: 42rpx;
  height: 42rpx;
  align-items: center;
  justify-content: center;
  padding: 0 14rpx;
  overflow: hidden;
  color: #5f786c;
  font-size: 20rpx;
  font-weight: 600;
  background: #edf3f0;
  border-radius: 999rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.log-actions {
  display: flex;
  gap: 9rpx;
}

.log-action {
  display: flex;
  box-sizing: border-box;
  min-width: 70rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  padding: 0 13rpx;
  color: #697a72;
  font-size: 21rpx;
  font-weight: 600;
  background: #f0f4f2;
  border-radius: 16rpx;
}

.edit-action {
  color: #60786c;
  background: #edf3f0;
}

.delete-action {
  color: #ad6964;
  background: #f8eeec;
}

.empty-card {
  padding: 54rpx 30rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
  background: #86a99a;
  border-radius: 22rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #34423c;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-text {
  margin-top: 8rpx;
  color: #77827d;
  font-size: 24rpx;
}
.list-footer {
  padding: 18rpx 0 34rpx;
  color: #91a39b;
  font-size: 24rpx;
  text-align: center;
}
