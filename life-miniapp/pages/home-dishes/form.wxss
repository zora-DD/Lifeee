.page{min-height:100vh;padding:28rpx 26rpx 70rpx;box-sizing:border-box;background:linear-gradient(180deg,#fff4e9,#f4f7f3)}
.hero{padding:12rpx 5rpx 25rpx}
.eyebrow{color:#c5764c;font-size:18rpx;font-weight:700;letter-spacing:3rpx}
.title{margin-top:10rpx;font-size:37rpx;font-weight:750}
.subtitle{margin-top:8rpx;color:#8e877f;font-size:22rpx;line-height:1.55}
.form-card{padding:25rpx;background:#fff;border-radius:28rpx;box-shadow:0 10rpx 26rpx rgba(74,58,43,.07)}
.cover{position:relative;height:330rpx;overflow:hidden;background:#f7f1e9;border-radius:22rpx}
.cover image{width:100%;height:100%}
.cover-empty{display:flex;height:100%;align-items:center;justify-content:center;color:#a38468;font-size:24rpx}
.cover-status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:24rpx;font-weight:650;background:rgba(42,30,22,.48)}
.image-hint{margin-top:11rpx;color:#a29488;font-size:19rpx;text-align:center}
.field{margin-top:23rpx}
.field>text{display:block;margin-bottom:10rpx;color:#5b554e;font-size:22rpx;font-weight:650}
.field input,.field textarea,.picker{width:100%;padding:19rpx;color:#38342f;font-size:24rpx;background:#faf8f5;border:1rpx solid #eee7de;border-radius:17rpx;box-sizing:border-box}
.field input,.picker{height:70rpx}
.field textarea{height:125rpx}
.field .steps{height:260rpx;line-height:1.65}
.field .experience{height:160rpx}
.field-hint{margin-top:8rpx;color:#aaa096;font-size:19rpx}
.row{display:flex;gap:14rpx}
.half{min-width:0;flex:1}
.save{display:flex;height:80rpx;margin-top:24rpx;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:700;background:linear-gradient(135deg,#dc8a54,#bd663e);border-radius:23rpx}
.save.disabled{opacity:.55}
