.form-page {
  padding-bottom: 70rpx;
}

.cover-card {
  position: relative;
  height: 230rpx;
  overflow: hidden;
}

.cover-empty {
  display: flex;
  height: 100%;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e8f0ec, #edf1f4);
}

.cover-icon {
  display: flex;
  width: 88rpx;
  height: 88rpx;
  align-items: center;
  justify-content: center;
  margin-right: 24rpx;
  font-size: 42rpx;
  background: rgba(255, 255, 255, 0.82);
  border-radius: 25rpx;
}

.cover-title {
  color: #3d4943;
  font-size: 28rpx;
  font-weight: 600;
}

.cover-hint {
  margin-top: 8rpx;
  color: #7e8983;
  font-size: 22rpx;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.cover-actions {
  position: absolute;
  right: 18rpx;
  bottom: 16rpx;
  display: flex;
  gap: 16rpx;
  padding: 10rpx 15rpx;
  color: #ffffff;
  font-size: 22rpx;
  background: rgba(31, 39, 35, 0.58);
  border-radius: 18rpx;
}

.remove-cover {
  color: #ffd5d1;
}

.form-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.form-section-title {
  margin-bottom: 28rpx;
  color: #34423c;
  font-size: 30rpx;
  font-weight: 700;
}

.form-group {
  margin-bottom: 30rpx;
}

.last-group {
  margin-bottom: 0;
}

.form-label {
  margin-bottom: 13rpx;
  color: #3c4943;
  font-size: 25rpx;
  font-weight: 600;
}

.required {
  color: #c96460;
}

.form-input,
.form-textarea,
.picker-field {
  box-sizing: border-box;
  width: 100%;
  color: #303d37;
  font-size: 25rpx;
  background: #f5f7f6;
  border: 1rpx solid #dfe6e2;
  border-radius: 17rpx;
}

.form-input,
.picker-field {
  height: 80rpx;
  padding: 0 20rpx;
}

.form-input {
  line-height: 80rpx;
}

.picker-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.form-textarea {
  height: 190rpx;
  padding: 20rpx;
  line-height: 1.6;
}

.form-textarea.short {
  height: 150rpx;
}

.visit-selector {
  display: flex;
  gap: 14rpx;
}

.visit-option {
  display: flex;
  flex: 1;
  align-items: center;
  padding: 20rpx 17rpx;
  color: #6f7974;
  background: #f4f6f5;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
}

.visit-option.active.wishlist {
  color: #8c673d;
  background: #f8f0e5;
  border-color: #ddc199;
}

.visit-option.active.visited {
  color: #4f735f;
  background: #edf4f0;
  border-color: #abc7ba;
}

.visit-option-icon {
  margin-right: 12rpx;
  font-size: 31rpx;
  font-weight: 700;
}

.visit-option-title {
  font-size: 24rpx;
  font-weight: 600;
}

.visit-option-note {
  margin-top: 4rpx;
  font-size: 22rpx;
  opacity: 0.78;
}

.visit-fields {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.travel-fields {
  display: flex;
  gap: 16rpx;
}

.half {
  flex: 1;
  min-width: 0;
  margin-bottom: 0;
}

.location-hint {
  margin-top: 18rpx;
  color: #8b9590;
  font-size: 22rpx;
  line-height: 1.5;
}

.save-button {
  margin-top: 30rpx;
  color: #ffffff;
  font-size: 28rpx;
  background: #6f9785;
  box-shadow: 0 10rpx 24rpx rgba(67, 103, 87, 0.18);
}

.save-button::after {
  border: 0;
}
