.task-heading-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.task-heading-actions {
  display: flex;
  gap: 10rpx;
}

.task-tool-entry {
  display: inline-flex;
  height: 56rpx;
  align-items: center;
  padding: 0 17rpx;
  color: #527765;
  font-size: 21rpx;
  font-weight: 650;
  background: #e9f2ed;
  border: 1rpx solid #d6e5dd;
  border-radius: 999rpx;
}

.task-tool-entry.routine {
  color: #7b6746;
  background: #f6f0e5;
  border-color: #eadfc9;
}

.task-tool-icon {
  margin-right: 7rpx;
  font-size: 25rpx;
}

.stats-card {
  display: flex;
  padding: 28rpx 10rpx;
}

.ai-entry {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  padding: 23rpx 25rpx;
  background: linear-gradient(135deg, #edf6f1, #fffaf2);
  border: 1rpx solid rgba(105, 145, 126, 0.12);
}

.ai-entry-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 29rpx;
  background: linear-gradient(145deg, #77a38e, #5f8b76);
  border-radius: 19rpx;
  box-shadow: 0 8rpx 18rpx rgba(72, 112, 93, 0.18);
}

.ai-entry-copy {
  min-width: 0;
  margin-left: 18rpx;
}

.ai-entry-title {
  color: #35463e;
  font-size: 27rpx;
  font-weight: 700;
}

.ai-entry-text {
  margin-top: 5rpx;
  color: #7c8882;
  font-size: 21rpx;
}

.ai-entry-arrow {
  margin-left: auto;
  color: #8fa198;
  font-size: 38rpx;
}

.ai-summary-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  background: rgba(34, 44, 39, 0.38);
}

.ai-summary-sheet {
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 120rpx);
  padding: 16rpx 30rpx calc(28rpx + env(safe-area-inset-bottom));
  overflow: hidden;
  background: #f8faf9;
  border-radius: 36rpx 36rpx 0 0;
}

.ai-sheet-handle {
  width: 68rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  background: #d3ddd8;
  border-radius: 999rpx;
}

.ai-sheet-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.ai-sheet-kicker {
  color: #6d8b7d;
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.ai-sheet-title {
  margin-top: 5rpx;
  color: #2f3e37;
  font-size: 34rpx;
  font-weight: 750;
}

.ai-sheet-close {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  align-items: center;
  justify-content: center;
  color: #728079;
  font-size: 38rpx;
  background: #edf2ef;
  border-radius: 50%;
}

.ai-sheet-loading,
.ai-sheet-error {
  display: flex;
  min-height: 330rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #75817b;
  font-size: 24rpx;
}

.ai-sheet-loading .loading-ring {
  margin-bottom: 22rpx;
}

.ai-retry {
  margin-top: 22rpx;
  padding: 14rpx 28rpx;
  color: #4f7865;
  background: #e6f1eb;
  border-radius: 999rpx;
}

.ai-sheet-scroll {
  max-height: calc(100vh - 280rpx - env(safe-area-inset-bottom));
  margin-top: 25rpx;
}

.ai-summary-copy {
  padding: 25rpx;
  color: #394941;
  font-size: 27rpx;
  line-height: 1.65;
  background: linear-gradient(145deg, #e8f3ed, #f6f8f7);
  border-radius: 24rpx;
}

.ai-summary-counts {
  display: flex;
  gap: 12rpx;
  margin-top: 18rpx;
}

.ai-count {
  display: flex;
  min-width: 0;
  flex: 1;
  flex-direction: column;
  align-items: center;
  padding: 18rpx 8rpx;
  color: #78847e;
  font-size: 20rpx;
  background: #ffffff;
  border-radius: 19rpx;
}

.ai-count text:first-child {
  margin-bottom: 4rpx;
  color: #47574f;
  font-size: 30rpx;
  font-weight: 750;
}

.ai-count.overdue text:first-child { color: #b85e57; }
.ai-count.today text:first-child { color: #a8753c; }
.ai-count.upcoming text:first-child { color: #5d8974; }

.ai-block {
  margin-top: 24rpx;
}

.ai-block-title {
  margin-bottom: 13rpx;
  color: #425149;
  font-size: 24rpx;
  font-weight: 700;
}

.ai-focus-item {
  display: flex;
  align-items: center;
  padding: 18rpx 20rpx;
  background: #ffffff;
  border-radius: 18rpx;
}

.ai-focus-item + .ai-focus-item {
  margin-top: 10rpx;
}

.ai-focus-mark {
  width: 8rpx;
  height: 48rpx;
  flex-shrink: 0;
  margin-right: 16rpx;
  background: #83a795;
  border-radius: 999rpx;
}

.ai-focus-mark.priority-high { background: #d5766e; }
.ai-focus-mark.priority-medium { background: #d6a45f; }
.ai-focus-mark.priority-low { background: #78a2b5; }

.ai-focus-main {
  min-width: 0;
  flex: 1;
}

.ai-focus-title {
  overflow: hidden;
  color: #38473f;
  font-size: 25rpx;
  font-weight: 650;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ai-focus-meta {
  margin-top: 5rpx;
  color: #89938e;
  font-size: 20rpx;
}

.ai-focus-actions {
  display: flex;
  gap: 12rpx;
  margin-top: 13rpx;
}

.ai-focus-action {
  padding: 8rpx 16rpx;
  font-size: 20rpx;
  font-weight: 650;
  border-radius: 999rpx;
}

.ai-focus-action.complete {
  color: #4f7965;
  background: #e8f2ed;
}

.ai-focus-action.postpone {
  color: #93672e;
  background: #f8efdf;
}

.ai-focus-action.disabled {
  opacity: 0.55;
}

.ai-focus-arrow {
  margin-left: 12rpx;
  color: #9ca7a1;
  font-size: 31rpx;
}

.suggestion-block {
  padding: 22rpx;
  background: #fffaf2;
  border-radius: 22rpx;
}

.ai-suggestion {
  display: flex;
  color: #59675f;
  font-size: 23rpx;
  line-height: 1.55;
}

.ai-suggestion + .ai-suggestion {
  margin-top: 12rpx;
}

.ai-suggestion text {
  display: flex;
  width: 34rpx;
  height: 34rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  color: #6d8b7d;
  font-size: 19rpx;
  background: #e9f1ed;
  border-radius: 50%;
}

.ai-sheet-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 4rpx 6rpx;
  color: #98a19d;
  font-size: 19rpx;
}

.ai-refresh {
  color: #557c69;
  font-weight: 650;
}

.stat-item {
  position: relative;
  flex: 1;
  text-align: center;
}

.stat-item + .stat-item::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #e8ecea;
  content: '';
}

.stat-value {
  font-size: 35rpx;
  font-weight: 700;
}

.stat-value.total { color: #52625b; }
.stat-value.active { color: #c58b4c; }
.stat-value.completed { color: #6f9b87; }
.stat-value.rate { color: #68899a; }

.stat-label {
  margin-top: 6rpx;
  color: #78837e;
  font-size: 22rpx;
}

.filter-card {
  margin-top: 24rpx;
  padding: 24rpx;
}

.search-row {
  display: flex;
  align-items: center;
  height: 76rpx;
  padding: 0 22rpx;
  background: #f5f7f6;
  border: 1rpx solid #dfe6e2;
  border-radius: 20rpx;
}

.search-icon {
  margin-right: 12rpx;
  color: #80958c;
  font-size: 30rpx;
}

.search-input {
  flex: 1;
  font-size: 26rpx;
}

.search-action {
  padding-left: 16rpx;
  color: #557f6c;
  font-size: 25rpx;
  font-weight: 600;
}

.retry-action {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 176rpx;
  height: 68rpx;
  margin-top: 26rpx;
  padding: 0 28rpx;
  color: #47745a;
  font-size: 26rpx;
  font-weight: 600;
  background: #e4f2e9;
  border-radius: 34rpx;
}

.filter-group {
  display: flex;
  min-width: 0;
  align-items: center;
  margin-top: 22rpx;
}

.filter-label {
  width: 84rpx;
  flex: 0 0 84rpx;
  color: #78857f;
  font-size: 22rpx;
  font-weight: 600;
}

.filter-scroll {
  width: 0;
  flex: 1;
  white-space: nowrap;
}

.priority-group {
  margin-top: 14rpx;
}

.owner-group {
  margin-top: 14rpx;
}

.owner-chip {
  min-width: 116rpx;
}

.filter-row {
  display: inline-flex;
  gap: 12rpx;
}

.filter-chip,
.priority-chip {
  box-sizing: border-box;
  min-width: 82rpx;
  padding: 10rpx 20rpx;
  color: #66726c;
  font-size: 23rpx;
  text-align: center;
  background: #f7f8f7;
  border: 1rpx solid #e5eae7;
  border-radius: 18rpx;
}

.filter-chip.active,
.priority-chip.active {
  color: #426f5b;
  background: #e7f2ec;
  border-color: #b9d3c6;
  box-shadow: inset 0 0 0 1rpx rgba(99, 145, 124, 0.05);
  font-weight: 600;
}

.priority-chip.priority-high.active {
  color: #a7514c;
  background: #f8e9e7;
  border-color: #eac5c1;
}

.priority-chip.priority-medium.active {
  color: #93672e;
  background: #f8efdf;
  border-color: #ead4ad;
}

.priority-chip.priority-low.active {
  color: #527a8e;
  background: #eaf1f4;
  border-color: #c7dce5;
}

.section-label {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 34rpx 4rpx 18rpx;
  color: #34423c;
  font-size: 28rpx;
  font-weight: 600;
}

.section-hint {
  color: #89928e;
  font-size: 22rpx;
  font-weight: 400;
}

.task-swipe {
  position: relative;
  margin-bottom: 18rpx;
  overflow: hidden;
  border-radius: 28rpx;
}

.completed-fold {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 4rpx 0 18rpx;
  padding: 21rpx 24rpx;
  color: #65736c;
  font-size: 24rpx;
  background: #edf2ef;
  border: 1rpx solid #dce7e1;
  border-radius: 22rpx;
}

.completed-fold-main {
  display: flex;
  align-items: center;
  font-weight: 650;
}

.completed-fold-icon {
  display: inline-flex;
  width: 34rpx;
  height: 34rpx;
  align-items: center;
  justify-content: center;
  margin-right: 12rpx;
  color: #ffffff;
  font-size: 20rpx;
  background: #789988;
  border-radius: 50%;
}

.completed-fold-action {
  color: #5d806f;
  font-size: 22rpx;
}

.swipe-delete {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 0;
  display: flex;
  width: 136rpx;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 23rpx;
  background: #c96863;
  opacity: 0;
  visibility: hidden;
  transition: opacity 100ms ease-out;
}

.task-swipe.revealing .swipe-delete {
  opacity: 1;
  visibility: visible;
}

.delete-icon {
  margin-bottom: 2rpx;
  font-size: 38rpx;
  line-height: 1;
}

.task-card {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  display: flex;
  width: 100%;
  align-items: flex-start;
  padding: 25rpx 24rpx 24rpx 26rpx;
  overflow: hidden;
  transition: transform 180ms ease-out;
}

.task-card.dragging {
  transition: none;
}

.complete-feedback {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 4;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #456f5c;
  font-size: 28rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
  background: rgba(232, 244, 238, 0.94);
  animation: task-complete-feedback 800ms ease both;
  pointer-events: none;
}

.complete-feedback-icon {
  display: flex;
  width: 50rpx;
  height: 50rpx;
  margin-right: 14rpx;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 29rpx;
  background: #6f9785;
  border-radius: 50%;
  box-shadow: 0 6rpx 16rpx rgba(71, 112, 93, 0.2);
}

@keyframes task-complete-feedback {
  0% {
    opacity: 0;
    transform: scale(0.98);
  }

  24%,
  82% {
    opacity: 1;
    transform: scale(1);
  }

  100% {
    opacity: 0.96;
    transform: scale(0.99);
  }
}

.task-card::before {
  position: absolute;
  top: 0;
  bottom: 0;
  left: 0;
  width: 7rpx;
  background: #829e92;
  content: '';
}

.task-card.priority-high::before { background: #d97a73; }
.task-card.priority-medium::before { background: #d6a15b; }
.task-card.priority-low::before { background: #709bb1; }

.task-card.completed {
  background: linear-gradient(135deg, #e8f0ec 0%, #f0f4f2 100%);
  border-color: #bfd2c8;
  box-shadow: inset 0 0 0 1rpx rgba(103, 139, 122, 0.08);
}

.task-card.completed::before {
  width: 9rpx;
  background: #6f9785;
}

.check-area {
  padding: 2rpx 10rpx 20rpx 0;
}

.check-area.readonly {
  opacity: 0.72;
}

.checkbox {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 40rpx;
  height: 40rpx;
  color: #ffffff;
  border: 3rpx solid #b9c7c1;
  border-radius: 12rpx;
}

.checkbox.checked {
  background: #6f9785;
  border-color: #6f9785;
}

.task-card.completed .checkbox.checked {
  box-shadow: 0 0 0 7rpx rgba(111, 151, 133, 0.12);
}

.task-main {
  flex: 1;
  min-width: 0;
  margin-left: 12rpx;
}

.task-title {
  font-size: 30rpx;
  font-weight: 600;
  line-height: 1.45;
}

.completed .task-title {
  color: #7d8983;
  text-decoration: line-through #7f9088;
  text-decoration-thickness: 2rpx;
}

.completed .task-main,
.completed .task-arrow {
  opacity: 0.68;
}

.completed .priority-label {
  color: #718078;
  background: #e8efeb;
}

.completed .due,
.completed .task-arrow {
  color: #89958f;
}

.completed .task-tag {
  color: #718078;
  background: #edf2ef;
}

.task-meta {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 8rpx 10rpx;
  margin-top: 11rpx;
  color: #69756f;
  font-size: 23rpx;
}

.priority-label {
  padding: 5rpx 12rpx;
  font-weight: 600;
  line-height: 1.25;
  border-radius: 12rpx;
}

.task-card.priority-high .priority-label {
  color: #a7514c;
  background: #f8e9e7;
}

.task-card.priority-medium .priority-label {
  color: #93672e;
  background: #f8efdf;
}

.task-card.priority-low .priority-label {
  color: #527a8e;
  background: #eaf1f4;
}

.due.overdue {
  color: #c85f5f;
}

.due {
  display: flex;
  align-items: center;
  margin-top: 11rpx;
  color: #84918b;
  font-size: 21rpx;
  line-height: 1.35;
  white-space: nowrap;
}

.due-icon {
  margin-right: 7rpx;
  font-size: 21rpx;
}

.due-state {
  margin-right: 8rpx;
  font-weight: 600;
}

.due-date {
  letter-spacing: 0.2rpx;
}

.postpone-action {
  flex-shrink: 0;
  margin-left: auto;
  padding: 6rpx 14rpx;
  color: #a3514c;
  font-size: 20rpx;
  font-weight: 650;
  background: #f8e9e7;
  border-radius: 999rpx;
}

.postpone-action.disabled {
  opacity: 0.55;
}

.task-tag {
  display: inline-flex;
  align-items: center;
  padding: 5rpx 13rpx;
  color: #527767;
  font-size: 21rpx;
  line-height: 1.25;
  background: #eff4f1;
  border: 1rpx solid #e1ebe6;
  border-radius: 12rpx;
}

.task-tag-icon {
  margin-right: 6rpx;
  font-size: 19rpx;
}

.task-arrow {
  align-self: center;
  margin-left: 10rpx;
  color: #9ca6a1;
  font-size: 44rpx;
}

.list-footer {
  padding: 18rpx 0 42rpx;
  color: #929c97;
  font-size: 23rpx;
  text-align: center;
}

.empty-card {
  padding: 54rpx 30rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  margin: 0 auto;
  color: #ffffff;
  font-size: 34rpx;
  background: #86a99a;
  border-radius: 24rpx;
}

.empty-title {
  margin-top: 20rpx;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-text {
  margin-top: 8rpx;
  color: #77827d;
  font-size: 24rpx;
}

.create-button {
  position: fixed;
  right: 36rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  background: #6f9785;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 24rpx rgba(67, 103, 87, 0.2);
}

.create-plus {
  margin-right: 8rpx;
  font-size: 32rpx;
  line-height: 1;
}
