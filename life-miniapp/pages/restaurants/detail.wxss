.detail-page {
  padding-bottom: 70rpx;
}

.hero {
  position: relative;
  min-height: 300rpx;
  overflow: hidden;
  color: #ffffff;
  background: linear-gradient(145deg, #c9b69d, #9e8468);
  border-radius: 30rpx;
  box-shadow: 0 14rpx 36rpx rgba(73, 59, 45, 0.15);
}

.hero.tone-1 { background: linear-gradient(145deg, #87a890, #5f7f69); }
.hero.tone-2 { background: linear-gradient(145deg, #c8a67d, #987653); }
.hero.tone-3 { background: linear-gradient(145deg, #86a9b2, #5d7d87); }
.hero.tone-4 { background: linear-gradient(145deg, #b99296, #8b696e); }

.hero-cover,
.hero-shade {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

.hero-shade {
  background: linear-gradient(180deg, rgba(24, 29, 27, 0.12), rgba(24, 29, 27, 0.74));
}

.hero-content {
  position: relative;
  z-index: 1;
  box-sizing: border-box;
  min-height: 300rpx;
  padding: 30rpx 34rpx 36rpx;
}

.hero.has-cover,
.hero.has-cover .hero-content {
  min-height: 360rpx;
}

.hero.has-cover .hero-content {
  display: flex;
  flex-direction: column;
}

.hero.has-cover .hero-title {
  margin-top: auto;
  padding-top: 70rpx;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.favorite-button {
  display: flex;
  box-sizing: border-box;
  width: 54rpx;
  height: 54rpx;
  align-items: center;
  justify-content: center;
  color: rgba(255, 255, 255, 0.9);
  font-size: 31rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 18rpx;
}

.favorite-button.active {
  color: #9a4f4a;
  background: rgba(255, 242, 239, 0.94);
}

.favorite-button.disabled {
  opacity: 0.55;
}

.favorite-hover {
  opacity: 0.75;
}

.category-pill,
.preference-pill {
  padding: 8rpx 15rpx;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  border-radius: 18rpx;
}

.hero-icon {
  margin-top: 34rpx;
  font-size: 58rpx;
}

.hero-title {
  margin-top: 32rpx;
  font-size: 48rpx;
  font-weight: 700;
  line-height: 1.3;
}

.hero-icon + .hero-title {
  margin-top: 8rpx;
}

.hero-meta {
  margin-top: 12rpx;
  font-size: 25rpx;
  opacity: 0.9;
}

.summary-card {
  display: flex;
  align-items: stretch;
  margin-top: 24rpx;
  padding: 26rpx 22rpx;
}

.summary-item {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.summary-item.wide {
  flex: 1.5;
}

.summary-value {
  color: #805f41;
  font-size: 38rpx;
  font-weight: 700;
}

.money-value {
  color: #805f41;
  font-size: 31rpx;
}

.summary-label {
  margin-top: 7rpx;
  color: #7e8883;
  font-size: 22rpx;
}

.summary-divider {
  width: 1rpx;
  margin: 5rpx 20rpx;
  background: #e7ebe9;
}

.memory-card,
.info-card {
  margin-top: 24rpx;
  padding: 32rpx;
}

.card-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-kicker {
  color: #9a744d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 3rpx;
}

.section-title {
  margin-top: 5rpx;
  color: #334039;
  font-size: 30rpx;
  font-weight: 700;
}

.info-card > .section-title {
  margin-top: 0;
  margin-bottom: 14rpx;
}

.memory-icon {
  position: relative;
  display: flex;
  width: 62rpx;
  height: 62rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #8e6a46;
  background: #f7f0e7;
  border: 1rpx solid #ebddcc;
  border-radius: 19rpx;
}

.meal-bowl {
  position: relative;
  box-sizing: border-box;
  width: 31rpx;
  height: 16rpx;
  margin-top: 9rpx;
  border: 3rpx solid #987452;
  border-top: 0;
  border-radius: 0 0 16rpx 16rpx;
}

.meal-bowl::after {
  position: absolute;
  right: 5rpx;
  bottom: -7rpx;
  left: 5rpx;
  height: 3rpx;
  background: #987452;
  border-radius: 2rpx;
  content: '';
}

.meal-steam {
  position: absolute;
  top: -17rpx;
  width: 3rpx;
  height: 11rpx;
  background: #b29373;
  border-radius: 3rpx;
  transform: rotate(8deg);
}

.steam-left {
  left: 7rpx;
}

.steam-right {
  right: 7rpx;
  transform: rotate(-8deg);
}

.meal-content {
  margin-top: 18rpx;
  color: #303c36;
  font-size: 31rpx;
  font-weight: 600;
  line-height: 1.55;
}

.memory-meta {
  display: flex;
  align-items: center;
  margin-top: 25rpx;
  color: #7b8580;
  font-size: 23rpx;
}

.last-amount {
  margin-left: 14rpx;
  padding: 5rpx 12rpx;
  color: #886744;
  font-weight: 600;
  background: #f7f0e7;
  border-radius: 12rpx;
}

.note-box {
  margin-top: 22rpx;
  padding: 22rpx 24rpx;
  background: #f6f7f6;
  border-left: 5rpx solid #c9ad8d;
  border-radius: 4rpx 16rpx 16rpx 4rpx;
}

.note-label {
  color: #8c6d4e;
  font-size: 22rpx;
  font-weight: 600;
}

.note-text {
  margin-top: 8rpx;
  color: #626d67;
  font-size: 25rpx;
  line-height: 1.7;
}

.history-card {
  margin-top: 22rpx;
  padding: 28rpx;
}

.history-heading,
.history-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.history-count {
  padding: 7rpx 15rpx;
  color: #5f7f70;
  font-size: 21rpx;
  background: #eaf2ee;
  border-radius: 999rpx;
}

.history-list {
  margin-top: 24rpx;
}

.history-item {
  display: flex;
}

.history-line {
  position: relative;
  width: 28rpx;
  flex-shrink: 0;
}

.history-dot {
  position: relative;
  z-index: 1;
  width: 15rpx;
  height: 15rpx;
  margin-top: 9rpx;
  background: #79a08d;
  border: 5rpx solid #edf4f0;
  border-radius: 50%;
}

.history-tail {
  position: absolute;
  top: 30rpx;
  bottom: 0;
  left: 11rpx;
  width: 2rpx;
  background: #dce7e1;
}

.history-item:last-child .history-tail {
  display: none;
}

.history-main {
  min-width: 0;
  flex: 1;
  padding: 0 0 25rpx 13rpx;
}

.history-meta {
  color: #69756f;
  font-size: 23rpx;
}

.history-amount {
  color: #8f6a45;
  font-weight: 650;
}

.history-meal {
  margin-top: 8rpx;
  color: #35433c;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.5;
}

.history-note {
  margin-top: 6rpx;
  color: #7e8983;
  font-size: 22rpx;
  line-height: 1.55;
}

.history-empty {
  margin-top: 22rpx;
  padding: 30rpx 20rpx;
  color: #8a948f;
  font-size: 23rpx;
  text-align: center;
  background: #f6f8f7;
  border-radius: 18rpx;
}

.info-row {
  display: flex;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #e9ecea;
}

.info-row:last-child {
  padding-bottom: 0;
  border-bottom: 0;
}

.info-label {
  width: 150rpx;
  color: #7a847f;
  font-size: 24rpx;
}

.info-value {
  flex: 1;
  color: #38453f;
  font-size: 25rpx;
  line-height: 1.55;
}

.address-value {
  min-width: 0;
}

.navigation-action {
  flex-shrink: 0;
  align-self: center;
  margin-left: 16rpx;
  padding: 8rpx 17rpx;
  color: #4f7865;
  font-size: 21rpx;
  font-weight: 650;
  background: #e8f2ed;
  border-radius: 999rpx;
}

.action-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.detail-share-button {
  display: flex;
  box-sizing: border-box;
  height: 78rpx;
  align-items: center;
  justify-content: center;
  margin: 16rpx 0 0;
  padding: 0;
  color: #6f644f;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1;
  background: #f7f3ec;
  border: 1rpx solid #e8dfd1;
  border-radius: 20rpx;
}

.detail-share-button::after {
  border: 0;
}

.share-button-icon {
  display: flex;
  width: 40rpx;
  height: 40rpx;
  align-items: center;
  justify-content: center;
  margin-right: 11rpx;
  color: #ffffff;
  font-size: 21rpx;
  background: #a68a68;
  border-radius: 13rpx;
}

.share-button-hover {
  opacity: 0.78;
}

.action-row button {
  flex: 1;
  margin: 0;
  font-size: 27rpx;
  border-radius: 18rpx;
}

.edit-button {
  color: #4f7464;
  background: #edf3f0;
}

.record-button {
  color: #ffffff;
  background: #6f9785;
}

.edit-button::after,
.record-button::after,
.sheet-actions button::after {
  border: 0;
}

.consumption-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: flex-end;
  background: rgba(27, 35, 31, 0.48);
}

.consumption-sheet {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  max-height: calc(100vh - 48rpx);
  flex-direction: column;
  overflow: hidden;
  padding: 18rpx 32rpx calc(34rpx + env(safe-area-inset-bottom));
  background: #fffdf9;
  border-radius: 36rpx 36rpx 0 0;
  box-shadow: 0 -18rpx 60rpx rgba(29, 38, 34, 0.16);
}

.consumption-scroll {
  min-height: 0;
  max-height: 70vh;
}

.sheet-handle {
  width: 66rpx;
  height: 7rpx;
  margin: 0 auto 24rpx;
  background: #d5dbd8;
  border-radius: 4rpx;
}

.sheet-title {
  color: #303d37;
  font-size: 34rpx;
  font-weight: 700;
}

.sheet-subtitle {
  margin-top: 7rpx;
  color: #7a857f;
  font-size: 22rpx;
}

.sheet-row {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.sheet-field {
  margin-top: 22rpx;
}

.sheet-row .sheet-field {
  margin-top: 0;
}

.sheet-field.half {
  flex: 1;
  min-width: 0;
}

.sheet-label {
  margin-bottom: 11rpx;
  color: #46534d;
  font-size: 24rpx;
  font-weight: 600;
}

.sheet-input,
.sheet-textarea {
  box-sizing: border-box;
  width: 100%;
  color: #303d37;
  font-size: 25rpx;
  background: #f4f6f5;
  border: 1rpx solid #dfe6e2;
  border-radius: 16rpx;
}

.sheet-input {
  height: 78rpx;
  padding: 0 19rpx;
  line-height: 78rpx;
}

.picker-input,
.amount-input {
  display: flex;
  align-items: center;
  justify-content: space-between;
  line-height: normal;
}

.amount-input input {
  flex: 1;
  min-width: 0;
  margin-left: 10rpx;
}

.sheet-textarea {
  height: 130rpx;
  padding: 18rpx 19rpx;
  line-height: 1.55;
}

.sheet-actions {
  display: flex;
  flex-shrink: 0;
  gap: 16rpx;
  margin-top: 28rpx;
}

.sheet-actions button {
  flex: 1;
  margin: 0;
  font-size: 26rpx;
  border-radius: 18rpx;
}

.sheet-cancel {
  color: #65716b;
  background: #eef1ef;
}

.sheet-save {
  color: #ffffff;
  background: #6f9785;
}
