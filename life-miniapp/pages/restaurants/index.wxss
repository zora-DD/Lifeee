.recommend-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx;
  background: linear-gradient(135deg, #f8f2e9, #eef4f1);
}

.recommend-copy {
  min-width: 0;
}

.recommend-kicker {
  color: #91704b;
  font-size: 23rpx;
  font-weight: 600;
}

.recommend-title {
  margin-top: 7rpx;
  color: #303c37;
  font-size: 32rpx;
  font-weight: 700;
}

.recommend-note {
  margin-top: 8rpx;
  color: #77817c;
  font-size: 22rpx;
}

.recommend-button {
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  margin-left: 20rpx;
  padding: 18rpx 22rpx;
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 600;
  background: #bd9670;
  border-radius: 24rpx;
  box-shadow: 0 7rpx 18rpx rgba(115, 83, 52, 0.16);
}

.dice {
  margin-right: 8rpx;
}

.overview-card {
  display: flex;
  margin-top: 24rpx;
  padding: 26rpx 10rpx;
}

.overview-item {
  position: relative;
  flex: 1;
  min-width: 0;
  text-align: center;
}

.overview-item + .overview-item::before {
  position: absolute;
  top: 8rpx;
  bottom: 8rpx;
  left: 0;
  width: 1rpx;
  background: #e2e8e5;
  content: '';
}

.overview-value {
  overflow: hidden;
  color: #52625b;
  font-size: 32rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.overview-label {
  margin-top: 5rpx;
  color: #7a847f;
  font-size: 22rpx;
}

.overview-value.visits { color: #6f9785; }
.overview-value.spent { color: #9a744d; }

.category-picker {
  margin-left: auto;
}

.list-filters {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-left: 16rpx;
}

.list-filters .category-picker {
  margin-left: 0;
}

.picker-value {
  display: flex;
  align-items: center;
  padding: 13rpx 18rpx;
  color: #4f645b;
  font-size: 23rpx;
  background: #ffffff;
  border: 1rpx solid #dfe6e2;
  border-radius: 20rpx;
}

.picker-value.compact {
  max-width: 176rpx;
  padding: 12rpx 15rpx;
}

.picker-value.compact > text:first-child {
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #819089;
  font-size: 26rpx;
}

.list-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 28rpx 4rpx 18rpx;
  color: #34423c;
  font-size: 28rpx;
  font-weight: 600;
}

.result-count {
  color: #89928e;
  font-size: 22rpx;
  font-weight: 400;
}

.restaurant-card {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx;
}

.restaurant-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  overflow: hidden;
  font-size: 40rpx;
  background: #f5eee5;
  border-radius: 24rpx;
}

.restaurant-icon.tone-1 { background: linear-gradient(145deg, #eef5ed, #dceadf); }
.restaurant-icon.tone-2 { background: linear-gradient(145deg, #faf1e7, #f1e1ce); }
.restaurant-icon.tone-3 { background: linear-gradient(145deg, #edf4f6, #dce9ed); }
.restaurant-icon.tone-4 { background: linear-gradient(145deg, #f7edef, #eadcdf); }

.restaurant-cover {
  width: 100%;
  height: 100%;
}

.restaurant-main {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.name {
  max-width: 230rpx;
  overflow: hidden;
  font-size: 32rpx;
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.preference-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  width: 112rpx;
  height: 48rpx;
  flex-shrink: 0;
  font-size: 24rpx;
  font-weight: 500;
  line-height: 1;
  border-radius: 16rpx;
  white-space: nowrap;
}

.preference-icon {
  width: 28rpx;
  margin-right: 4rpx;
  text-align: center;
}

.preference-label {
  line-height: 1;
}

.preference-okay {
  color: #67716c;
  background: #f0f2f1;
}

.preference-good {
  color: #577566;
  background: #edf3f0;
}

.preference-love {
  color: #a05e68;
  background: #f7ecee;
}

.preference-must {
  color: #9a6339;
  background: #f8eee2;
}

.meta,
.visit-meta,
.restaurant-note {
  margin-top: 10rpx;
  color: #6d7772;
  font-size: 24rpx;
}

.meta {
  display: flex;
  align-items: center;
}

.category-tag {
  margin-right: 12rpx;
  padding: 4rpx 10rpx;
  color: #8b6642;
  font-size: 22rpx;
  background: #f5eee5;
  border-radius: 10rpx;
}

.visit-meta {
  color: #5f6e67;
}

.visit-status {
  display: inline-flex;
  margin-right: 10rpx;
  padding: 3rpx 10rpx;
  font-size: 20rpx;
  border-radius: 999rpx;
}

.visit-status.status-wishlist {
  color: #7b704b;
  background: #f7f0dc;
}

.visit-status.status-visited {
  color: #557565;
  background: #eaf2ee;
}

.visit-status.status-frequent {
  color: #9a6339;
  background: #f8e9dc;
}

.restaurant-note {
  overflow: hidden;
  color: #7b6a59;
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.arrow {
  margin-left: 12rpx;
  color: #a1aaa5;
  font-size: 46rpx;
}

.empty-card {
  padding: 54rpx 30rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 72rpx;
  height: 72rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  color: #8b6642;
  font-size: 25rpx;
  font-weight: 700;
  background: #f6eee4;
  border-radius: 22rpx;
}

.empty-title {
  margin-top: 18rpx;
  color: #34423c;
  font-size: 29rpx;
  font-weight: 600;
}

.empty-text {
  margin-top: 8rpx;
  color: #77827d;
  font-size: 24rpx;
}

.create-button {
  position: fixed;
  right: 36rpx;
  bottom: calc(148rpx + env(safe-area-inset-bottom));
  z-index: 20;
  display: flex;
  align-items: center;
  padding: 20rpx 28rpx;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 600;
  background: #6f9785;
  border-radius: 34rpx;
  box-shadow: 0 10rpx 24rpx rgba(67, 103, 87, 0.2);
}

.create-plus {
  margin-right: 8rpx;
  font-size: 32rpx;
  line-height: 1;
}

.picker-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 1200;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  background: rgba(27, 35, 31, 0.48);
}

.picker-panel {
  position: relative;
  box-sizing: border-box;
  width: 100%;
  max-width: 620rpx;
  max-height: calc(100vh - 80rpx);
  padding: 0;
  overflow: hidden;
  text-align: center;
  background: #fffdf9;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 36rpx;
  box-shadow: 0 30rpx 80rpx rgba(22, 29, 26, 0.24);
}

.picker-scroll {
  max-height: calc(100vh - 80rpx);
}

.picker-content {
  box-sizing: border-box;
  padding: 44rpx 38rpx 38rpx;
}

.picker-panel::before {
  position: absolute;
  top: -90rpx;
  right: -70rpx;
  width: 230rpx;
  height: 230rpx;
  background: #eef4f1;
  border-radius: 50%;
  content: '';
}

.picker-close {
  position: absolute;
  top: 20rpx;
  right: 22rpx;
  z-index: 2;
  display: flex;
  width: 52rpx;
  height: 52rpx;
  align-items: center;
  justify-content: center;
  color: #77817c;
  font-size: 38rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 50%;
}

.picker-eyebrow {
  position: relative;
  color: #9a744d;
  font-size: 22rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
}

.picker-heading {
  position: relative;
  margin-top: 8rpx;
  color: #2f3c36;
  font-size: 38rpx;
  font-weight: 700;
}

.draw-stage {
  position: relative;
  width: 250rpx;
  height: 250rpx;
  margin: 34rpx auto 28rpx;
}

.draw-ring {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  background: linear-gradient(145deg, #f8eee1, #edf4f0);
  border: 2rpx dashed #c8b394;
  border-radius: 50%;
}

.picking .draw-ring {
  animation: restaurant-spin 720ms linear infinite;
}

.draw-center {
  position: absolute;
  top: 50%;
  left: 50%;
  display: flex;
  width: 108rpx;
  height: 108rpx;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  background: #ffffff;
  border-radius: 50%;
  box-shadow: 0 10rpx 28rpx rgba(65, 77, 71, 0.12);
  transform: translate(-50%, -50%);
}

.picked .draw-center {
  animation: result-pop 320ms ease-out;
}

.orbit-icon {
  position: absolute;
  font-size: 34rpx;
}

.orbit-icon.top { top: 13rpx; left: 103rpx; }
.orbit-icon.right { top: 103rpx; right: 13rpx; }
.orbit-icon.bottom { bottom: 13rpx; left: 103rpx; }
.orbit-icon.left { top: 103rpx; left: 13rpx; }

.picking-title,
.result-name {
  color: #303d37;
  font-size: 34rpx;
  font-weight: 700;
}

.picking-note,
.result-meta {
  margin-top: 10rpx;
  color: #79837e;
  font-size: 23rpx;
}

.result-kicker {
  color: #99734d;
  font-size: 22rpx;
  font-weight: 600;
}

.result-name {
  margin-top: 8rpx;
  font-size: 38rpx;
}

.result-summary {
  display: flex;
  align-items: stretch;
  margin-top: 22rpx;
  padding: 18rpx 20rpx;
  background: #f7f0e7;
  border-radius: 16rpx;
}

.result-stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  align-items: center;
}

.result-stat-value {
  color: #66513e;
  font-size: 27rpx;
  font-weight: 650;
}

.result-stat-label {
  margin-top: 6rpx;
  color: #918171;
  font-size: 22rpx;
}

.result-stat-divider {
  width: 1rpx;
  margin: 2rpx 18rpx;
  background: #dfd1c0;
}

.result-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 28rpx;
}

.again-button,
.detail-button {
  display: flex;
  flex: 1;
  height: 76rpx;
  align-items: center;
  justify-content: center;
  font-size: 25rpx;
  font-weight: 600;
  border-radius: 20rpx;
}

.again-button {
  color: #607169;
  background: #f0f3f1;
}

.detail-button {
  color: #ffffff;
  background: #6f9785;
}

@keyframes restaurant-spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

@keyframes result-pop {
  0% { transform: translate(-50%, -50%) scale(0.82); }
  100% { transform: translate(-50%, -50%) scale(1); }
}
.list-footer {
  padding: 18rpx 0 34rpx;
  color: #91a39b;
  font-size: 24rpx;
  text-align: center;
}

