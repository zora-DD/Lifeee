.snack-list-heading{display:flex;margin:29rpx 4rpx 16rpx;justify-content:space-between;color:#5d5146;font-size:28rpx;font-weight:700}.snack-list-heading text+text{color:#9b8d80;font-size:22rpx;font-weight:400}.snack-card{display:flex;min-height:160rpx;margin-bottom:20rpx;padding:24rpx 26rpx;align-items:center;box-sizing:border-box}.snack-cover{display:flex;width:160rpx;height:160rpx;flex-shrink:0;align-items:center;justify-content:center;overflow:hidden;background:linear-gradient(145deg,#fff0ce,#f6dfbc);border-radius:24rpx;font-size:52rpx}.snack-cover image{width:100%;height:100%}.snack-main{min-width:0;flex:1;margin-left:24rpx}.snack-name-row{display:flex;min-width:0;align-items:center;justify-content:space-between;gap:12rpx}.snack-name{min-width:0;overflow:hidden;color:#40372f;font-size:32rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.snack-status{display:inline-flex;flex-shrink:0;padding:6rpx 11rpx;font-size:19rpx;font-weight:650;border-radius:999rpx}.snack-status.status-wishlist{color:#8b7042;background:#f8efd9}.snack-status.status-eaten{color:#557565;background:#eaf2ee}.snack-status.status-frequent{color:#a75f3c;background:#f9e8dc}.snack-status.status-avoid{color:#a05050;background:#faeaea}.snack-meta{display:flex;flex-wrap:wrap;gap:9rpx;margin-top:11rpx}.snack-meta text{padding:5rpx 9rpx;color:#9b6736;font-size:19rpx;background:#fff2df;border-radius:999rpx}.snack-place{margin-top:12rpx;color:#877b70;font-size:21rpx}.snack-memory{margin-top:8rpx;overflow:hidden;color:#aa7741;font-size:20rpx;text-overflow:ellipsis;white-space:nowrap}.snack-create{background:linear-gradient(135deg,#d79249,#b96a32)}
.snack-picker-mask{background:rgba(48,34,20,.52)}.snack-picker-panel::before{background:#fff2cf}.snack-picker-eyebrow,.snack-result-kicker{color:#ad7338}.snack-draw-stage{position:relative;width:230rpx;height:230rpx;margin:32rpx auto 28rpx}.snack-draw-ring{position:absolute;inset:0;background:linear-gradient(145deg,#fff2d7,#fffaf0);border:2rpx dashed #d5a46c;border-radius:50%}.snack-draw-stage.picking .snack-draw-ring{animation:restaurant-spin 720ms linear infinite}.snack-draw-center{position:absolute;top:50%;left:50%;display:flex;width:106rpx;height:106rpx;align-items:center;justify-content:center;font-size:54rpx;background:#fff;border-radius:50%;box-shadow:0 10rpx 28rpx rgba(116,75,35,.14);transform:translate(-50%,-50%)}.snack-draw-stage.picked .snack-draw-center{animation:result-pop 320ms ease-out}.snack-result-summary{background:#fff5e4}.snack-stat-divider{background:#e8d4b8}.snack-again-button{color:#94602e;background:#fff1de}.snack-detail-button{background:#bc7b3f}
