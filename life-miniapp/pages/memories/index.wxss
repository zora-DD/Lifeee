.memory-page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 28rpx 28rpx 190rpx;
  background: #f6f8f7;
}

.memory-hero {
  position: relative;
  box-sizing: border-box;
  min-height: 310rpx;
  padding: 52rpx 38rpx;
  overflow: hidden;
  background: linear-gradient(135deg, #f7eee7 0%, #f4f7f2 52%, #eaf3ee 100%);
  border: 1rpx solid rgba(222, 229, 224, 0.9);
  border-radius: 34rpx;
  box-shadow: 0 14rpx 34rpx rgba(56, 70, 63, 0.07);
}

.hero-orb {
  position: absolute;
  border: 1rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 50%;
}

.hero-orb-one {
  top: -55rpx;
  right: -25rpx;
  width: 230rpx;
  height: 230rpx;
  background: rgba(255, 255, 255, 0.35);
}

.hero-orb-two {
  right: 145rpx;
  bottom: -100rpx;
  width: 190rpx;
  height: 190rpx;
  background: rgba(210, 229, 219, 0.42);
}

.memory-eyebrow {
  position: relative;
  color: #a06f6b;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.memory-title {
  position: relative;
  margin-top: 13rpx;
  color: #34423b;
  font-size: 54rpx;
  font-weight: 750;
  letter-spacing: 2rpx;
}

.memory-subtitle {
  position: relative;
  margin-top: 13rpx;
  color: #68766f;
  font-size: 24rpx;
  line-height: 1.6;
}

.memory-count {
  position: relative;
  display: inline-flex;
  margin-top: 24rpx;
  padding: 9rpx 17rpx;
  color: #6b8075;
  font-size: 20rpx;
  background: rgba(255, 255, 255, 0.66);
  border-radius: 999rpx;
}

.year-scroll {
  width: 100%;
  margin-top: 28rpx;
  white-space: nowrap;
}

.year-list {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 2rpx 8rpx;
}

.year-chip {
  padding: 14rpx 24rpx;
  color: #748078;
  font-size: 23rpx;
  background: #ffffff;
  border: 1rpx solid #e1e8e4;
  border-radius: 999rpx;
}

.year-chip.active {
  color: #ffffff;
  font-weight: 650;
  background: #688b7b;
  border-color: #688b7b;
  box-shadow: 0 8rpx 18rpx rgba(75, 112, 94, 0.17);
}

.timeline {
  margin-top: 27rpx;
}

.memory-item {
  display: flex;
}

.timeline-rail {
  position: relative;
  width: 40rpx;
  flex-shrink: 0;
}

.timeline-dot {
  position: relative;
  z-index: 2;
  box-sizing: border-box;
  width: 21rpx;
  height: 21rpx;
  margin: 6rpx auto 0;
  background: #f6f8f7;
  border: 5rpx solid #84a493;
  border-radius: 50%;
}

.timeline-line {
  position: absolute;
  top: 22rpx;
  bottom: -6rpx;
  left: 50%;
  width: 2rpx;
  background: #d9e4de;
  transform: translateX(-50%);
}

.memory-item:last-child .timeline-line {
  display: none;
}

.memory-content {
  width: calc(100% - 40rpx);
  padding: 0 0 30rpx 15rpx;
}

.memory-meta {
  display: flex;
  min-height: 32rpx;
  align-items: center;
  margin-bottom: 13rpx;
}

.memory-date {
  color: #52665c;
  font-size: 24rpx;
  font-weight: 700;
}

.memory-place {
  max-width: 320rpx;
  margin-left: 13rpx;
  overflow: hidden;
  color: #8a958f;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.memory-place::before {
  margin-right: 7rpx;
  content: '·';
}

.preview-badge {
  margin-left: auto;
  padding: 5rpx 12rpx;
  color: #a56b66;
  font-size: 18rpx;
  background: #f7eae7;
  border-radius: 999rpx;
}

.memory-card {
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #e1e7e4;
  border-radius: 28rpx;
  box-shadow: 0 10rpx 28rpx rgba(43, 58, 50, 0.065);
}

.memory-images {
  display: grid;
  width: 100%;
  height: 360rpx;
  overflow: hidden;
  background: #e8eeeb;
}

.memory-images.image-count-1 {
  height: auto;
}

.memory-images.image-count-2,
.memory-images.image-count-3,
.memory-images.image-count-4,
.memory-images.image-count-5,
.memory-images.image-count-6,
.memory-images.image-count-7,
.memory-images.image-count-8,
.memory-images.image-count-9 {
  grid-template-columns: repeat(2, 1fr);
  gap: 4rpx;
}

.memory-image {
  display: block;
  width: 100%;
  height: 100%;
}

.image-count-1 .memory-image {
  height: auto;
}

.image-count-2 .memory-image {
  height: 360rpx;
}

.image-count-3 .memory-image,
.image-count-4 .memory-image,
.image-count-5 .memory-image,
.image-count-6 .memory-image,
.image-count-7 .memory-image,
.image-count-8 .memory-image,
.image-count-9 .memory-image {
  height: 240rpx;
}

.memory-images.image-count-3,
.memory-images.image-count-4,
.memory-images.image-count-5,
.memory-images.image-count-6,
.memory-images.image-count-7,
.memory-images.image-count-8,
.memory-images.image-count-9 {
  height: auto;
}

.memory-copy {
  padding: 25rpx 27rpx 27rpx;
}

.memory-card-title {
  color: #334039;
  font-size: 29rpx;
  font-weight: 700;
}

.memory-description {
  margin-top: 9rpx;
  color: #758079;
  font-size: 22rpx;
  line-height: 1.6;
}

.load-more,
.memory-empty {
  margin-top: 5rpx;
  color: #9aa39e;
  font-size: 20rpx;
  text-align: center;
}

.memory-empty {
  padding: 100rpx 0;
  font-size: 24rpx;
}

.add-memory-button {
  position: fixed;
  z-index: 8;
  right: 32rpx;
  bottom: calc(34rpx + env(safe-area-inset-bottom));
  display: flex;
  width: 220rpx;
  height: 84rpx;
  align-items: center;
  justify-content: center;
  margin: 0;
  padding: 0;
  color: #ffffff;
  font-size: 25rpx;
  font-weight: 650;
  background: #668b79;
  border-radius: 999rpx;
  box-shadow: 0 13rpx 28rpx rgba(60, 100, 81, 0.25);
}

.add-memory-button::after {
  border: 0;
}

.add-icon {
  margin-right: 7rpx;
  font-size: 34rpx;
  font-weight: 400;
}
