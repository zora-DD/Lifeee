.permission-page {
  padding-bottom: calc(160rpx + env(safe-area-inset-bottom));
}

.user-card {
  display: flex;
  align-items: center;
  padding: 28rpx;
}

.user-avatar {
  display: flex;
  width: 78rpx;
  height: 78rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 34rpx;
  border-radius: 25rpx;
}

.user-copy {
  min-width: 0;
  margin-left: 20rpx;
}

.user-name {
  color: #33413a;
  font-size: 29rpx;
  font-weight: 700;
}

.user-signature {
  margin-top: 6rpx;
  overflow: hidden;
  color: #7d8983;
  font-size: 21rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.user-status {
  flex-shrink: 0;
  margin-left: auto;
  padding: 8rpx 15rpx;
  color: #567765;
  font-size: 19rpx;
  background: #e9f2ed;
  border-radius: 999rpx;
}

.section-heading {
  margin: 30rpx 4rpx 16rpx;
  color: #526159;
  font-size: 23rpx;
  font-weight: 700;
}

.template-scroll {
  width: 100%;
  white-space: nowrap;
}

.template-list {
  display: inline-flex;
  gap: 12rpx;
  padding: 2rpx 2rpx 8rpx;
}

.template-chip {
  padding: 14rpx 22rpx;
  color: #627068;
  font-size: 21rpx;
  background: #edf2ef;
  border-radius: 999rpx;
}

.template-chip.primary {
  color: #426b58;
  background: #e2f0e8;
}

.template-chip.danger {
  color: #94645e;
  background: #f7ecea;
}

.permission-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 20rpx;
}

.permission-card {
  padding: 26rpx;
}

.module-heading {
  display: flex;
  align-items: center;
}

.module-icon {
  display: flex;
  width: 58rpx;
  height: 58rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #567765;
  font-size: 25rpx;
  font-weight: 700;
  background: #eaf2ee;
  border-radius: 19rpx;
}

.module-copy {
  min-width: 0;
  margin-left: 17rpx;
}

.module-name {
  color: #35423c;
  font-size: 26rpx;
  font-weight: 700;
}

.module-description {
  margin-top: 5rpx;
  color: #87918c;
  font-size: 20rpx;
}

.level-switch {
  display: flex;
  gap: 8rpx;
  margin-top: 22rpx;
  padding: 7rpx;
  background: #f1f4f2;
  border-radius: 18rpx;
}

.level-option {
  flex: 1;
  padding: 13rpx 4rpx;
  color: #77837d;
  font-size: 21rpx;
  text-align: center;
  border-radius: 13rpx;
}

.level-option.active {
  color: #456b59;
  font-weight: 700;
  background: #ffffff;
  box-shadow: 0 5rpx 14rpx rgba(55, 75, 65, 0.09);
}

.level-option.level-none {
  color: #98645e;
}

.level-note {
  min-height: 30rpx;
  margin-top: 12rpx;
  color: #929c97;
  font-size: 19rpx;
  line-height: 1.5;
}

.save-button {
  position: fixed;
  right: 34rpx;
  bottom: calc(28rpx + env(safe-area-inset-bottom));
  left: 34rpx;
  z-index: 10;
  color: #ffffff;
  font-size: 26rpx;
  font-weight: 700;
  background: #628a76;
  border-radius: 22rpx;
  box-shadow: 0 12rpx 28rpx rgba(63, 105, 84, 0.22);
}

.save-button::after {
  border: 0;
}
