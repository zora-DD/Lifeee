.review-page {
  padding-bottom: 70rpx;
}

.status-tabs {
  width: 100%;
  margin-bottom: 24rpx;
  white-space: nowrap;
}

.status-tabs-inner {
  display: inline-flex;
  gap: 14rpx;
  padding: 2rpx 2rpx 8rpx;
}

.status-tab {
  padding: 14rpx 25rpx;
  color: #75817b;
  font-size: 23rpx;
  background: #edf1ef;
  border: 1rpx solid transparent;
  border-radius: 999rpx;
}

.status-tab.active {
  color: #456b59;
  font-weight: 700;
  background: #e5f0ea;
  border-color: #cfe0d7;
}

.request-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.request-card {
  padding: 28rpx;
}

.request-main {
  display: flex;
  align-items: center;
}

.request-avatar {
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  font-size: 33rpx;
  border-radius: 24rpx;
}

.request-content {
  min-width: 0;
  margin-left: 20rpx;
}

.request-name {
  color: #33413a;
  font-size: 28rpx;
  font-weight: 700;
}

.request-time {
  margin-top: 7rpx;
  color: #8a948f;
  font-size: 20rpx;
}

.request-status {
  margin-left: auto;
  padding: 7rpx 14rpx;
  color: #8a6a3f;
  font-size: 19rpx;
  background: #f6efe4;
  border-radius: 999rpx;
}

.request-status.approved {
  color: #4f7563;
  background: #e9f2ed;
}

.request-status.rejected {
  color: #99635e;
  background: #f7eae8;
}

.request-signature {
  margin-top: 10rpx;
  padding: 18rpx 20rpx;
  color: #68746e;
  font-size: 22rpx;
  line-height: 1.55;
  background: #f5f7f6;
  border-radius: 16rpx;
}

.request-note{margin-top:20rpx;padding:18rpx 20rpx;color:#42574d;font-size:24rpx;font-weight:650;line-height:1.55;background:#edf4f0;border:1rpx solid #dce9e2;border-radius:16rpx}.request-note.empty{color:#9a8170;font-weight:500;background:#faf4ed;border-color:#f0e2d4}.request-note-label{display:block;margin-bottom:5rpx;color:#7d8c84;font-size:18rpx;font-weight:500}

.request-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 22rpx;
}

.action-button {
  width: 150rpx;
  margin: 0;
  font-size: 23rpx;
  border-radius: 18rpx;
}

.action-button::after {
  border: 0;
}

.action-button.reject {
  color: #a05f58;
  background: #fff4f2;
}

.action-button.approve,
.action-button.permission {
  color: #ffffff;
  background: #668d7a;
}

.action-button.permission {
  width: 210rpx;
}

.empty-card {
  padding: 70rpx 30rpx;
  text-align: center;
}

.empty-icon {
  display: flex;
  width: 70rpx;
  height: 70rpx;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  color: #5f806f;
  font-size: 30rpx;
  background: #e8f1ec;
  border-radius: 24rpx;
}

.empty-title {
  margin-top: 20rpx;
  color: #405047;
  font-size: 27rpx;
  font-weight: 700;
}

.empty-text {
  margin-top: 9rpx;
  color: #89928e;
  font-size: 22rpx;
}
