.page{min-height:100vh;padding:25rpx 25rpx 80rpx;box-sizing:border-box;background:#f7f4ed}.cover{position:relative;height:440rpx;overflow:hidden;background:#f1e6d7;border-radius:30rpx}.cover image{width:100%;height:100%}.cover-empty{display:flex;height:100%;align-items:center;justify-content:center;font-size:92rpx}.cover-shade{position:absolute;right:0;bottom:0;left:0;padding:70rpx 28rpx 26rpx;color:#fff;background:linear-gradient(transparent,rgba(42,27,16,.84))}.title-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.title{min-width:0;overflow:hidden;font-size:39rpx;font-weight:750;text-overflow:ellipsis;white-space:nowrap}.status{flex-shrink:0;padding:7rpx 13rpx;font-size:20rpx;font-weight:700;border-radius:999rpx;background:rgba(255,255,255,.2)}.meta{margin-top:8rpx;font-size:21rpx;opacity:.86}.stats{display:grid;grid-template-columns:repeat(2,1fr);margin-top:17rpx;padding:23rpx 10rpx;background:#fff;border-radius:24rpx}.stats view{text-align:center}.stats view+view{border-left:1rpx solid #eee6dc}.stats text{display:block;margin-top:6rpx;color:#948b83;font-size:18rpx}.stats .stat-value{margin-top:0;color:#b9683f;font-size:27rpx;font-weight:750}.stats .date-value{font-size:20rpx}.card{margin-top:17rpx;padding:26rpx;background:#fff;border-radius:24rpx}.card-title{display:flex;align-items:center;gap:10rpx;font-size:26rpx;font-weight:700}.content{margin-top:13rpx;color:#6e6760;font-size:24rpx;line-height:1.75;white-space:pre-wrap}.memory-card{display:flex;gap:17rpx;margin-top:17rpx;padding:24rpx;color:#765332;background:linear-gradient(135deg,#fff0cf,#fff8e9);border-radius:24rpx}.memory-card>text{font-size:34rpx}.memory-label{font-size:19rpx;opacity:.72}.memory-value{margin-top:5rpx;font-size:25rpx;font-weight:700}.record{padding:18rpx 0}.record+.record{border-top:1rpx solid #eee9e3}.record-date{font-size:23rpx;font-weight:650}.record-note{margin-top:6rpx;color:#938b84;font-size:21rpx}.actions{display:flex;gap:11rpx;margin-top:22rpx}.actions view{display:flex;height:70rpx;align-items:center;justify-content:center;border-radius:20rpx}.taste{flex:1;color:#fff;background:#c97b45}.edit{width:115rpx;color:#8e684f;background:#fff}.delete{width:100rpx;color:#ad625d;background:#fff0ee}.mask{position:fixed;z-index:30;inset:0;display:flex;align-items:flex-end;background:rgba(25,20,16,.48)}.panel{width:100%;padding:30rpx 27rpx calc(35rpx + env(safe-area-inset-bottom));background:#fff;border-radius:30rpx 30rpx 0 0}.panel-title{font-size:30rpx;font-weight:750}.input,.note-input{width:100%;margin-top:15rpx;padding:19rpx;background:#f8f6f2;border-radius:16rpx;box-sizing:border-box;font-size:23rpx}.note-input{height:145rpx}.panel-save{display:flex;height:72rpx;margin-top:18rpx;align-items:center;justify-content:center;color:#fff;background:#c97b45;border-radius:19rpx}
