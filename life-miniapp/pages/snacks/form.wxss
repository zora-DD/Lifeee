.page{min-height:100vh;padding:28rpx 26rpx 70rpx;box-sizing:border-box;background:linear-gradient(180deg,#fff6e9,#f4f7f3)}
.hero{padding:12rpx 5rpx 25rpx}.eyebrow{color:#c47742;font-size:18rpx;font-weight:700;letter-spacing:3rpx}.title{margin-top:10rpx;font-size:37rpx;font-weight:750}.subtitle{margin-top:8rpx;color:#8d857c;font-size:22rpx;line-height:1.55}
.form-card{position:relative;z-index:12;padding:25rpx;background:#fff;border-radius:28rpx;box-shadow:0 10rpx 26rpx rgba(74,58,43,.07)}
.cover{position:relative;height:340rpx;overflow:hidden;background:#f8eee1;border-radius:24rpx}.cover image{width:100%;height:100%}.cover-empty{display:flex;height:100%;flex-direction:column;gap:12rpx;align-items:center;justify-content:center;color:#a57d5b;font-size:46rpx}.cover-empty text{font-size:23rpx}.cover-status{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;color:#fff;font-size:24rpx;font-weight:650;background:rgba(42,30,22,.48)}.image-hint{margin-top:10rpx;color:#a29488;font-size:19rpx;text-align:center}
.field{margin-top:23rpx}.field>text{display:block;margin-bottom:10rpx;color:#5b554e;font-size:22rpx;font-weight:650}.field input,.field textarea,.select-trigger{width:100%;padding:19rpx;color:#38342f;font-size:24rpx;background:#faf8f5;border:1rpx solid #eee7de;border-radius:17rpx;box-sizing:border-box}.field input,.select-trigger{height:70rpx}.field textarea{height:180rpx;line-height:1.65}.select-row{display:flex;gap:14rpx}.half{min-width:0;flex:1}.select-field{position:relative}.select-trigger{display:flex;align-items:center;justify-content:space-between}.select-trigger.opened{border-color:#d89a73;background:#fffaf6}.select-menu{position:absolute;z-index:15;top:105rpx;right:0;left:0;max-height:350rpx;overflow-y:auto;background:#fff;border:1rpx solid #eadfd4;border-radius:18rpx;box-shadow:0 14rpx 34rpx rgba(67,46,30,.18)}.select-option{display:flex;min-height:68rpx;padding:0 17rpx;align-items:center;justify-content:space-between;color:#665f58;font-size:21rpx}.select-option+.select-option{border-top:1rpx solid #f1ebe5}.select-option.selected{color:#b9633c;font-weight:700;background:#fff7f0}.dropdown-mask{position:fixed;z-index:10;inset:0;background:rgba(39,30,23,.16)}
.save{display:flex;height:80rpx;margin-top:24rpx;align-items:center;justify-content:center;color:#fff;font-size:26rpx;font-weight:700;background:linear-gradient(135deg,#d98b4e,#bb633c);border-radius:23rpx}.save.disabled{opacity:.55}
